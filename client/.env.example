# ConnectHub Frontend Environment Configuration
# Duplicate this file to .env.local for local development or set in Netlify/Vercel dashboard

# Backend REST API Endpoint
# Local Development: http://localhost:5000/api
# Production (Render, Railway, Fly, VPS): https://your-backend-api.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Internal API URL (Used for SSR pages like /profile/[id] and /post/[id])
# Defaults to NEXT_PUBLIC_API_URL if omitted.
INTERNAL_API_URL=https://your-backend-api.onrender.com/api
