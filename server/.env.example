# ConnectHub Backend Environment Configuration
# Duplicate this file to .env for production or local overrides

# Server Environment
PORT=5000
NODE_ENV=production

# Database Configuration:
# For production (MongoDB Atlas):
# Get your connection string from cloud.mongodb.com -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/connecthub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/connecthub?retryWrites=true&w=majority

# For local development with standalone MongoDB:
# MONGODB_URI=mongodb://localhost:27017/connecthub

# Authentication Security
# Generate a strong 64-char key in terminal: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_production_secret_key_64_characters_min
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
# Supports comma-separated origins for production (Netlify, Vercel, custom domain):
# Example: https://connecthub.netlify.app,https://connecthub.vercel.app,http://localhost:3000
CLIENT_URL=https://your-connecthub-app.netlify.app,http://localhost:3000

# Cloudinary Media Storage (Optional but recommended for production):
# Sign up free at cloudinary.com -> Dashboard -> Product Environment Credentials
# When set, uploads stream directly to Cloudinary.
# When empty, uploads fallback automatically to local disk storage (./uploads).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local Disk Upload Path (used when Cloudinary is not configured)
UPLOAD_PATH=./uploads
